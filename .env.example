# router-benchmark environment configuration. Copy this to .env and fill in what you need —
# .env is gitignored (real values never get committed); this file is the tracked template.
#
#   cp .env.example .env
#
# Every value below is optional. Leaving it unset preserves current default behavior (verified
# live) — no plugins array sent, each router uses its own documented default.

# --- Provider credentials --------------------------------------------------------------------
# Optional if you've already authenticated Pi itself (`pi login <provider>`, or `pi auth check
# --provider <name>` to verify) — Pi manages its own credential store separately from this
# project. Set these only if you specifically want this project's .env to be the source of truth
# instead (spec §4 documents `export OPENROUTER_API_KEY=...` as a valid setup path).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- OpenRouter Pareto Code (spec §5) ----------------------------------------------------------
# Coding-quality tier threshold, 0-1. >=0.66 High, 0.33-0.65 Medium, <0.33 Low.
# Leave unset to use OpenRouter's own default (High) — confirmed live: Pareto Code works correctly
# with no plugins array at all, defaulting to High tier.
PARETO_MIN_CODING_SCORE=

# --- OpenRouter Auto (spec §6) -----------------------------------------------------------------
# Current OpenRouter parameter name. NOTE: the spec itself says "cost_quality_tradeoff" (0-10) —
# that's deprecated. OpenRouter's own current docs say cost_tier (low|medium|high|xhigh|max) is
# the live parameter; cost_quality_tradeoff is still accepted for backwards compatibility but
# cost_tier takes precedence if both are sent. Leave unset to use your OpenRouter account default.
AUTO_COST_TIER=

# Comma-separated wildcard patterns restricting Auto's candidate pool, e.g. "anthropic/*,openai/*"
# — spec §11 asks to "restrict OpenRouter Auto to the same models" used by Not Diamond/Avengers Pro
# for comparability. Leave unset and Auto draws from OpenRouter's entire catalogue (current
# behavior, verified — no static candidate list exists, it's usage-ranked across everything).
AUTO_ALLOWED_MODELS=
AUTO_EXCLUDED_MODELS=
