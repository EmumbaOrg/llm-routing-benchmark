# --- OpenRouter Pareto Code -----------------------------------------------------------------
# Coding-capability tier threshold (0-1). Omit to let Pareto Code default to its strongest
# available coders; if set, the router picks the cheapest model within that capability tier.
PARETO_MIN_CODING_SCORE=0.33

# --- OpenRouter Auto -------------------------------------------------------------------------
# Current cost-band knob: low / medium / high / xhigh / max (default: low). Takes precedence over
# AUTO_COST_QUALITY_TRADEOFF below if both are set.
AUTO_COST_TIER=
# Deprecated 0-10 form of the above, kept by OpenRouter for backwards compatibility. Prefer
# AUTO_COST_TIER in new configuration; this is only still used here for comparability with the
# original experiment spec.
AUTO_COST_QUALITY_TRADEOFF=7
# Comma-separated wildcard patterns restricting Auto's candidate pool, e.g. "anthropic/*,openai/*"
# Leave both blank for unrestricted.
AUTO_ALLOWED_MODELS=
AUTO_EXCLUDED_MODELS=

# --- Baseline (direct, no router) arm --------------------------------------------------------
# Lets `npm run bench` work with no CLI flags at all. --provider/--model on the command line still
# override these if given. BASELINE_MODEL is a bare model id (no provider/ prefix) — that
# namespaced-slug format is OpenRouter's own convention, not a plain provider's.
BASELINE_PROVIDER=openai
BASELINE_MODEL=gpt-5.3-codex

# --- Not Diamond -----------------------------------------------------------------------------
NOTDIAMOND_API_KEY=
# Optional, 0-10 (0 = Not Diamond's own quality-first default); omit to use that default. The
# candidate pool is NOT configured here — notdiamond-router.ts fetches Not Diamond's full live
# model catalog on every call instead, so it's always current and never a stale/curated subset.
NOTDIAMOND_COST_QUALITY_TRADEOFF=7
